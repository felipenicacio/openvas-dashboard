# systemd service — OpenVAS Dashboard backend v1.2.0
# Hardening: privilégio mínimo, filesystem protegido
#
# Instalação:
#   sudo bash deploy/install.sh
#
# NOTA: LoadCredential para jwt_secret e gvm_password é gerado em
#   /etc/systemd/system/ovdash-backend.service.d/credentials.conf
# pelo install.sh, condicionalmente, apenas quando os arquivos de credential
# existem. Isso garante backward compatibility durante upgrade: se os arquivos
# ainda não existem, o serviço inicia sem LoadCredential e usa as variáveis
# legadas do .env (modo deprecated, suporte removido na v1.3.0).

[Unit]
Description=OpenVAS Dashboard Backend (FastAPI/uvicorn)
After=network.target
Wants=network.target

[Service]
Type=simple

# ── Usuário e grupo dedicados (nunca root) ────────────────────────────────────
User=ovdash
Group=ovdash

# ── Diretório de trabalho e ambiente ──────────────────────────────────────────
WorkingDirectory=/opt/openvas-dashboard/backend
EnvironmentFile=/opt/openvas-dashboard/.env

# ── Comando de inicialização ──────────────────────────────────────────────────
ExecStart=/opt/openvas-dashboard/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level warning

Restart=on-failure
RestartSec=5s

# ── Hardening systemd ─────────────────────────────────────────────────────────
# Referência: systemd.exec(5) — seção "Sandboxing"

# Filesystem
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/openvas-dashboard/data
# Nota: BindReadOnlyPaths para /etc/openvas-dashboard/credentials foi removido
# intencionalmente. O processo não deve ter acesso direto ao diretório fonte
# das credentials. O fluxo correto é:
#   /etc/openvas-dashboard/credentials/* → PID 1 (systemd LoadCredential)
#     → CREDENTIALS_DIRECTORY → aplicação
# O drop-in credentials.conf (gerado pelo install.sh) define LoadCredential
# para cada arquivo de credential que existe no momento da instalação.

# Kernel e namespace
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
PrivateDevices=true
PrivateIPC=true
ProtectHostname=true
ProtectClock=true

# Chamadas de sistema (lista conservadora para Python/FastAPI)
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# ── Rede ─────────────────────────────────────────────────────────────────────
# Dois perfis suportados — ajuste conforme o deployment:
#
# PERFIL A — GVM via socket Unix local (padrão, recomendado):
#   GVM_SOCKET_PATH=/run/gvmd/gvmd.sock
#   O processo só precisa de loopback; AF_UNIX já cobre o socket.
#   IPAddressAllow abaixo protege tráfego TCP: apenas loopback (nginx → uvicorn).
#
# PERFIL B — GVM remoto via TLS (host separado):
#   GVM_HOST=<ip-do-servidor-gvm>  GVM_PORT=9390
#   Substitua IPAddressAllow pela linha comentada, colocando o IP real do GVM.
#   Nunca use 0.0.0.0/0 — defina apenas o IP específico do servidor GVM.
#
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Perfil A — GVM local via socket Unix (padrão):
IPAddressAllow=127.0.0.1/8 ::1/128
# Perfil B — GVM remoto (descomentar e substituir <IP-GVM> pelo IP real):
# IPAddressAllow=127.0.0.1/8 ::1/128 <IP-GVM>/32

IPAddressDeny=any

# Outros
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
