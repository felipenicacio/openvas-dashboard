# systemd service — OpenVAS Dashboard backend v1.1.0
# Hardening: privilégio mínimo, filesystem protegido
#
# Instalação:
#   sudo cp ovdash-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ovdash-backend

[Unit]
Description=OpenVAS Dashboard Backend (FastAPI/uvicorn)
After=network.target
Wants=network.target

[Service]
Type=simple

# ── Usuário e grupo dedicados (nunca root) ────────────────────────────────────
User=ovdash
Group=ovdash

# ── Diretório de trabalho e ambiente ──────────────────────────────────────────
WorkingDirectory=/opt/openvas-dashboard/backend
EnvironmentFile=/opt/openvas-dashboard/.env

# ── Comando de inicialização ──────────────────────────────────────────────────
ExecStart=/opt/openvas-dashboard/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level warning

Restart=on-failure
RestartSec=5s

# ── Hardening systemd ─────────────────────────────────────────────────────────
# Referência: systemd.exec(5) — seção "Sandboxing"

# Filesystem
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/openvas-dashboard/data

# Kernel e namespace
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
PrivateDevices=true
PrivateIPC=true
ProtectHostname=true
ProtectClock=true

# Chamadas de sistema (lista conservadora para Python/FastAPI)
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# Rede — apenas loopback necessário (nginx faz proxy)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressAllow=127.0.0.1/8 ::1/128
IPAddressDeny=any

# Outros
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
