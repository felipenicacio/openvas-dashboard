# ─────────────────────────────────────────────────────────────────────────────
# OpenVAS Dashboard — Exemplo de Configuração
#
# ATENÇÃO: NÃO versione este arquivo com senhas reais!
# Copie para .env e preencha os valores antes de iniciar o serviço.
# O arquivo .env já está no .gitignore — nunca faça git add .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Conexão GVM ──────────────────────────────────────────────────────────────
# Escolha UM dos modos: socket Unix (recomendado) OU host/porta (rede TLS).

# --- Modo A: Socket Unix local (GVM na mesma máquina ou via relay socat) ---
# Docker GVM (relay automático configurado pelo install.sh):
#   GVM_SOCKET_PATH=/run/gvmd.sock
# GVM nativo Linux (exemplo de caminhos comuns):
#   GVM_SOCKET_PATH=/run/gvmd/gvmd.sock
#   GVM_SOCKET_PATH=/var/run/gvmd/gvmd.sock
GVM_SOCKET_PATH=

# --- Modo B: Conexão de rede TLS (GVM em outra máquina) ---
# Deixe GVM_SOCKET_PATH vazio e preencha abaixo:
GVM_HOST=192.168.1.100
GVM_PORT=9390

# Credenciais GVM (usuário do gvmd, não do dashboard)
# Não use as credenciais padrão 'admin/admin' em produção!
GVM_USERNAME=admin
GVM_PASSWORD=

# ── Autenticação do Dashboard ─────────────────────────────────────────────────
# Usuário e senha para fazer login no painel web.
# APP_PASSWORD não tem valor padrão — deve ser definido antes de iniciar.
APP_USERNAME=admin
APP_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────────
# Segredo para assinar os tokens de sessão.
# Gere um valor seguro com: openssl rand -hex 32
# NUNCA use um valor fixo ou previsível em produção.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# ── Sincronização Automática ──────────────────────────────────────────────────
# Intervalo em minutos para buscar novos dados do GVM.
SYNC_INTERVAL_MINUTES=30

# ── Armazenamento ─────────────────────────────────────────────────────────────
# Diretório onde o banco SQLite será armazenado (criado automaticamente).
DATA_DIR=/opt/openvas-dashboard/data

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origens permitidas (separe por vírgula). Em produção, remova localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
