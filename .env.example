# ── OpenVAS / GVM Connection ──────────────────────────────────────
GVM_HOST=192.168.1.100
GVM_PORT=9390
GVM_USERNAME=admin
GVM_PASSWORD=admin
# Conexão via socket Unix local (deixe vazio se usar host/porta acima)
GVM_SOCKET_PATH=

# ── App Config ────────────────────────────────────────────────────
# Usuário da aplicação web (login no dashboard)
APP_USERNAME=admin
APP_PASSWORD=changeme

# Segredo JWT — gere com: openssl rand -hex 32
JWT_SECRET=TROQUE_ESTE_VALOR_COM_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=480

# ── Sincronização ─────────────────────────────────────────────────
# Intervalo em minutos para sincronizar dados do GVM automaticamente
SYNC_INTERVAL_MINUTES=30

# ── Dados ─────────────────────────────────────────────────────────
# Diretório onde o SQLite será armazenado (criado automaticamente)
DATA_DIR=/opt/openvas-dashboard/data

# ── CORS (para desenvolvimento local) ─────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
