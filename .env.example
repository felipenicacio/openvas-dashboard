# OpenVAS Dashboard — variáveis de ambiente
# Copie para .env e preencha com valores reais
# NUNCA commite o arquivo .env
#
# Gerar JWT_SECRET:    python3 -c "import secrets; print(secrets.token_hex(32))"
# Gerar senha hash:    python backend/generate_hash.py

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_ENV=production          # production | development
APP_USERNAME=admin          # login do dashboard

# Hash Argon2id — gerado com: python backend/generate_hash.py
APP_PASSWORD_HASH=          # $argon2id$v=19$m=65536,t=3,p=4$...

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=                 # mínimo 32 bytes, hex aleatório
JWT_EXPIRE_MINUTES=30       # duração da sessão em minutos
JWT_ISSUER=openvas-dashboard
JWT_AUDIENCE=openvas-dashboard-users

# ── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECURE=true          # false apenas em desenvolvimento HTTP local

# ── GVM ───────────────────────────────────────────────────────────────────────
GVM_SOCKET=/run/gvmd/gvmd.sock   # caminho do socket Unix (preferido)
# GVM_HOST=localhost             # alternativa TLS
# GVM_PORT=9390
GVM_USERNAME=admin
GVM_PASSWORD=               # senha do usuário GVM

# ── CORS (origens permitidas, separadas por vírgula) ──────────────────────────
# Deixar vazio em produção quando nginx serve frontend e API no mesmo domínio
# CORS_ORIGINS=https://meu-dominio.com

# ── API Docs (Swagger/ReDoc) ──────────────────────────────────────────────────
ENABLE_API_DOCS=false       # NUNCA true em produção

# ── Sync ──────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=30    # intervalo de sincronização com GVM
